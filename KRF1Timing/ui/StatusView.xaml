<UserControl x:Class="adjsw.F12026.StatusView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:adjsw.F12026"
             mc:Ignorable="d" 
             d:DesignHeight="30" d:DesignWidth="180">
    <Grid MinHeight="35">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Label Grid.Row="0" Name="m_text" Foreground="Green" HorizontalAlignment="Center" HorizontalContentAlignment="Center">...</Label>
        <UniformGrid Grid.Row="1" Rows="1" Columns="3" Name="m_sectorBlocks">
            <Rectangle Margin="2,0" Stroke="Black" Height="7" RadiusX="2" RadiusY="2" Name="m_rectS1" Fill="LightGreen"/>
            <Rectangle Margin="2,0" Stroke="Black" Height="7" RadiusX="2" RadiusY="2" Name="m_rectS2" Fill="#FFAD22CE"/>
            <Rectangle Margin="2,0" Stroke="Black" Height="7" RadiusX="2" RadiusY="2" Name="m_rectS3" Fill="Yellow"/>
        </UniformGrid>
    </Grid>
</UserControl>
